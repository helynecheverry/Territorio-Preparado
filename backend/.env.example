# Development only. Generate your own secret; never commit .env.local.
TP_ENV=development
TP_BIND=127.0.0.1:4180
TP_ORIGIN=http://127.0.0.1:4180
TP_SECRET=
TP_MONGO_URI=mongodb://127.0.0.1:27017
TP_MONGO_DB=territorio
TP_FRONTEND_DIR=../frontend/dist
TP_MODEL_DIR=../models/sos
TP_TRANSLATION_DIR=../models/translation-es-en
TP_MAIL_DIR=var/mail
# Empty SMTP host stores mail in private local files (development only).
TP_SMTP_HOST=
TP_SMTP_PORT=587
TP_SMTP_USER=
TP_SMTP_PASSWORD=
TP_MAIL_FROM=Territorio Preparado <no-reply@example.com>
# Register this exact redirect: http://127.0.0.1:4180/api/auth/google/callback
TP_GOOGLE_CLIENT_ID=
TP_GOOGLE_CLIENT_SECRET=
# --- Ingesta de amenazas ---
# Cada cuántos segundos se consultan los catálogos (15-3600).
TP_HAZARD_POLL_SECONDS=60
# Recuadro de consulta lon_min,lat_min,lon_max,lat_max. Generoso a propósito: un
# sismo en Panamá o Ecuador sacude Colombia; quién recibe aviso lo decide luego
# la distancia de cada persona, no este recuadro.
TP_HAZARD_BBOX=-85,-8,-64,16
TP_HAZARD_MIN_MAGNITUDE=3.0
TP_HAZARD_LOOKBACK_MINUTES=120
TP_USGS_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
# El SGC no publica una API documentada y no se raspa su portal. Vacío desactiva
# la fuente; ver la sección "Avisos de emergencia" del README.
TP_SGC_URL=
# --- Motor de alertas ---
TP_ALERT_POLL_SECONDS=30
TP_ALERT_EVENTS_PER_PASS=20
# Red de seguridad contra un reparto desbocado, no un límite de diseño.
TP_ALERT_MAX_PER_EVENT=2000000
# Coste máximo en SMS de un solo evento. Al agotarse, el resto se marca como
# omitido por presupuesto; el reparto va del más cercano al epicentro al más
# lejano, así que el presupuesto se gasta en quien más lo necesita.
TP_ALERT_SMS_BUDGET_PER_EVENT=5000
TP_ALERT_BATCH=2000
TP_ALERT_CONCURRENCY=64
# --- Recomendación de destino ---
TP_DESTINATION_RADIUS_KM=5
# Un separador vial no es un albergue.
TP_DESTINATION_MIN_AREA_M2=1000
TP_DESTINATION_CANDIDATES=200
# --- Entrega de avisos ---
# Genera el par con: ./scripts/run-local.sh vapid-keys
# Vacía desactiva Web Push, y sin Web Push el plan gratuito no recibe nada.
TP_VAPID_PRIVATE_KEY=
# Obligatorio junto a la clave: RFC 8292 lo exige en la reclamación sub.
TP_VAPID_CONTACT=mailto:ops@example.com
# SMS contra tu propio proveedor. Vacío desactiva el canal. La plantilla se
# escribe leyendo la documentación del proveedor que contrates; no hay plantillas
# de proveedores aquí porque una equivocada que parezca oficial es peor que nada.
TP_SMS_URL=
TP_SMS_AUTH_HEADER=
TP_SMS_CONTENT_TYPE=json
TP_SMS_BODY={"to":"{{to}}","message":"{{text}}"}
TP_DELIVERY_POLL_SECONDS=10
TP_DELIVERY_BATCH=500
TP_DELIVERY_MAX_ATTEMPTS=5
TP_DELIVERY_BACKOFF_SECONDS=30
# --- Cobro ---
# Vacío desactiva el cobro. El nombre solo identifica a la pasarela en el libro
# de eventos; la integración se configura con las variables de abajo.
TP_BILLING_PROVIDER=
# Secreto compartido con la pasarela. Vacío hace que el webhook responda 503:
# sin secreto no se puede distinguir un evento real de uno falsificado.
TP_BILLING_WEBHOOK_SECRET=
TP_BILLING_SIGNATURE_HEADER=x-signature
# De dónde sale la marca de tiempo: header:nombre o body:ruta.con.puntos
TP_BILLING_TIMESTAMP=header:x-timestamp
# Qué se firma. Se lee de la documentación de la pasarela que contrates.
TP_BILLING_SIGNED_TEMPLATE={{ts}}.{{body}}
TP_BILLING_TOLERANCE_SECONDS=300
TP_BILLING_PATH_EVENT_ID=data.id
TP_BILLING_PATH_REFERENCE=data.reference
TP_BILLING_PATH_STATUS=data.status
TP_BILLING_PATH_AMOUNT_CENTS=data.amount_in_cents
TP_BILLING_PATH_CURRENCY=data.currency
TP_BILLING_SUCCESS_STATUS=APPROVED
# Precio en la unidad mínima de la moneda: 2000000 = 20.000 COP
TP_PAID_PLAN_AMOUNT_CENTS=2000000
TP_PAID_PLAN_CURRENCY=COP
TP_PAID_PLAN_DAYS=30

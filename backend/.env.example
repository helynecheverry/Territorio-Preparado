# Development only. Generate your own secret; never commit .env.local.
TP_ENV=development
TP_BIND=127.0.0.1:4180
TP_ORIGIN=http://127.0.0.1:4180
TP_SECRET=
TP_MONGO_URI=mongodb://127.0.0.1:27017
TP_MONGO_DB=territorio
TP_FRONTEND_DIR=../frontend/dist
TP_MODEL_DIR=../models/sos
TP_TRANSLATION_DIR=../models/translation-es-en
TP_MAIL_DIR=var/mail
# Empty SMTP host stores mail in private local files (development only).
TP_SMTP_HOST=
TP_SMTP_PORT=587
TP_SMTP_USER=
TP_SMTP_PASSWORD=
TP_MAIL_FROM=Territorio Preparado <no-reply@example.com>
# Register this exact redirect: http://127.0.0.1:4180/api/auth/google/callback
TP_GOOGLE_CLIENT_ID=
TP_GOOGLE_CLIENT_SECRET=
